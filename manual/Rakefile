require 'rake/clean'
require 'erb'
require 'yaml'
require 'asciidoctor'
require 'asciidoctor-html5s'
require 'nokogiri'
require 'sass-embedded'
require 'font-awesome-sass'
require_relative 'lib/replacements'
require_relative 'lib/util'
require_relative 'lib/erb-context'


# Get languages from existing localisation file names
LANGS = Dir.entries('l10n')
.filter_map{|x| /\.(.+?)\.(?:yaml|po)$/.match x }
.map{|x| x[1] }.uniq.sort.map(&:to_sym)

LANGS.prepend :en
def LANGS.default() first end
def LANGS.default?(x) x == first end

# Flag tasks
noindex = false
desc 'Disallow search engine index in HTML'
task :noindex do noindex = true end

display_branch = nil
desc 'Set the displayed branch name'
task :display_branch, [:value] do |_, args| display_branch = args.value end


task default: :build
desc "Build HTML for all languages"
task :build => [:assets, 'po4a:translate'] do

  layout = ERB.new File.read 'src/template/_layout.erb'

  LANGS.each do |lang|

    # Load localized attributes with fallback
    attributes = ["l10n/attributes.#{lang}.yaml", 'l10n/attributes.yaml']
    .filter(&File.method(:exist?))
    .map{|f| Util.flatten_hash YAML.load_file f }
    .then{|hs| {}.merge! *hs.reverse }

    adoc_options = {
      safe: :safe,
      backend: 'html5s',
      parse: true,
      standalone: false,
      attributes: {'imagesdir' => '../images'}.merge(attributes.map{|k, v| ["#{k}@", v]}.to_h),
    }

    # Load index.adoc for the TOC and version
    index_doc = ["translated/#{lang}/index.adoc", 'src/index.adoc']
    .find(&File.method(:exist?))
    .then{|f| Asciidoctor.load_file f, adoc_options }
    mod_version = index_doc.attributes['mod-version']
    manual_toc = Util.html_strip index_doc.find_by(id: 'manual-toc')[0].convert, layers: 2

    # Generate page for each source (or translated) document
    src_dir = LANGS.default?(lang) ? 'src' : "translated/#{lang}"
    Dir.glob('*.adoc', base: src_dir).each do |src_file|

      name = File.basename src_file, '.adoc'
      src_path = "#{src_dir}/#{src_file}"
      output_path = "build/#{lang}/#{name}.html"
      puts "Generate page #{output_path}" if verbose

      document = Asciidoctor.load_file src_path, adoc_options
      authors = Util.git_file_authors "src/#{src_file}"
      translators = Util.git_file_authors("l10n/#{name}.#{lang}.po") - authors - %w(Weblate) unless LANGS.default?(lang)
      page_toc = document
        .then{|d| d.converter.convert d, 'outline', toclevels: 2 }
        .then{|s| Util.html_strip s, strip_class: true }
      content = document.convert
        .then{|s| Util.cache_id_images s, output_path }

      context = ERBContext.new(
        title: document.title,
        content: content,
        document: document,
        authors: authors,
        translators: translators,
        attributes: attributes,
        language: lang,
        languages: LANGS,
        mod_version: mod_version,
        manual_toc: manual_toc,
        page_toc: page_toc,
        output_path: output_path,
        display_branch: display_branch,
        noindex: noindex,
      )

      verbose(false) { mkdir_p File.dirname(output_path) }
      File.write output_path, layout.result(context.binding)
    end

    'src/template/translation-missing.erb'.then do |src_path|
      output_path = "build/#{lang}/translation-missing.html"
      puts "Generate page #{output_path}" if verbose
      context = ERBContext.new(
        attributes: attributes,
        language: lang,
        languages: LANGS,
        mod_version: mod_version,
        manual_toc: manual_toc,
        output_path: output_path,
        display_branch: display_branch,
        noindex: noindex,
      )
      template = ERB.new File.read src_path
      context.content = template.result context.binding
      File.write output_path, layout.result(context.binding)
    end
  end

  %w(index 404).each do |name|
    output_path = "build/#{name}.html"
    puts "Generate page #{output_path}" if verbose
    context = ERBContext.new(output_path: output_path, languages: LANGS)
    template = ERB.new File.read "src/template/#{name}.erb"
    File.write output_path, template.result(context.binding)
  end
end


namespace 'po4a' do

  desc "Update po4a config"
  task :config do
    template = ERB.new File.read 'l10n/po4a.cfg.erb'
    content = template.result_with_hash(
      languages: LANGS,
      documents: Dir.glob('*.adoc', base: 'src').map{|f| File.basename f, '.adoc' },
    )
    if content != (File.read('l10n/po4a.cfg') rescue nil)
      puts "Write po4a.cfg" if verbose
      File.write 'l10n/po4a.cfg', content
    end
  end

  desc "Update translation files"
  task :update => :config do
    cd 'l10n' do
      sh *%W(po4a --no-translations po4a.cfg)
    end
  end

  desc "Generate translated documents"
  task :translate => :config do
    cd 'l10n' do
      sh *%W(po4a --no-update po4a.cfg)
    end
  end

end


desc 'Build static assets'
task :assets

# Define assets to be copied to `build`
{
  'build/images' => 'src/images',
  'build/fonts/fa-solid-900.woff2' => "#{FontAwesome::Sass.fonts_path}/font-awesome/fa-solid-900.woff2",
}
.each do |dest, src|
  task :assets => dest
  file dest => src do |task|
    verbose(false) { mkdir_p File.dirname(task.name) }
    if File.directory? task.prereqs[0]
      cp_lr task.prereqs[0], File.dirname(task.name), remove_destination: true
    else
      cp task.prereqs[0], File.dirname(task.name)
    end
  end
end

# Compile SCSS
task :assets => 'build/style.css'
file 'build/style.css' => 'src/template/style.scss' do |task|
  verbose(false) { mkdir_p 'build' }
  dest, src = task.name, task.prereqs[0]
  puts "sass #{src} > #{dest}" if verbose
  result = Sass.compile(src, source_map: true, source_map_include_sources: true)
  File.write dest, result.css + "\n/*# sourceMappingURL=#{File.basename dest}.map */"
  File.write "#{dest}.map", result.source_map
end


CLEAN << 'translated'
CLOBBER << 'build'
