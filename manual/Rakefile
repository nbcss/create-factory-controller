require 'rake/clean'
require 'erb'
require 'yaml'
require 'asciidoctor'
require 'asciidoctor-html5s'
require 'nokogiri'
require 'sass-embedded'
require 'font-awesome-sass'
require_relative 'lib/replacements'
require_relative 'lib/util'
require_relative 'lib/manual-builder'


# Get languages from existing localisation file names
LANGS = Dir.entries('l10n')
.map{|x| x.split '.' }.filter{|x| x.length >= 3 }.map{|x| x[-2] }
.uniq.map(&:to_sym)

LANGS.prepend :en
def LANGS.default() first end
def LANGS.default?(x) x == first end


# Define tasks to build manual pages
task default: :build
desc "Build HTML for all languages"
task :build => [:assets]

manual_builder = ManualBuilder.new(
  layout_path: 'src/template/_layout.erb',
  source_path_tmpl: proc do |arg|
    (LANGS.default?(arg[:lang]) ? 'src/%{name}.adoc' : 'translated/%{lang}/%{name}.adoc') % arg
  end,
  attributes_path_tmpl: proc do |arg|
    (LANGS.default?(arg[:lang]) ? 'l10n/attributes.yaml' : 'l10n/attributes.%{lang}.yaml') % arg
  end,
  po_path_tmpl: proc {|arg| 'l10n/%{name}.%{lang}.po' % arg },
  output_path_tmpl: proc {|arg| 'build/%{lang}/%{name}.html' % arg },
  languages: LANGS
)

doc_names = Dir.glob('[^_]*.adoc', base: 'src')
.map{|f| File.basename f, '.adoc' }

LANGS.each do |lang|
  build_lang_task = :"build_#{lang.to_s.gsub '-', '_'}"
  task :build => build_lang_task

  desc "Build HTML of language #{lang}"
  task build_lang_task

  doc_names.each do |name|
    doc = manual_builder.document(name: name, lang: lang)
    task build_lang_task => doc.output_path

    file doc.output_path =>
    doc.dependency_files + [:assets] do
      puts "Generate page #{doc.output_path}" if verbose
      doc.build
    end
  end

  tm_page = manual_builder.page(output_path: "build/#{lang}/translation-missing.html", source_path: "src/template/translation-missing.erb", lang: lang)
  task build_lang_task => tm_page.output_path
  file tm_page.output_path => tm_page.dependency_files do
    puts "Generate page #{tm_page.output_path}" if verbose
    tm_page.build
  end
end


rule /^translated\/.*\.adoc$/ => 'po4a:translate'

namespace 'po4a' do

  desc "Update po4a config"
  task :config do
    orig = File.read('l10n/po4a.cfg')
    changed = orig.sub(/(?<=\[po4a_langs\] ).*$/) do
      LANGS[1..-1].join(' ')
    end
    if orig != changed
      puts "Write po4a.cfg" if verbose
      File.write 'l10n/po4a.cfg', changed
    end
  end

  desc "Update translation files"
  task :update => :config do
    cd 'l10n' do
      sh *%W(po4a --no-translations po4a.cfg)
    end
  end

  desc "Generate translated documents"
  task :translate => :config do
    cd 'l10n' do
      sh *%W(po4a --no-update po4a.cfg)
    end
  end

end


desc 'Build static assets'
task :assets

# Define assets to be copied to `build`
{
  'build/images' => 'src/images',
  'build/fonts/fa-solit-900.woff2' => "#{FontAwesome::Sass.fonts_path}/font-awesome/fa-solid-900.woff2",
}
.each do |dest, src|
  task :assets => dest
  file dest => src do |task|
    verbose(false) { mkdir_p File.dirname(task.name) }
    if File.directory? task.prereqs[0]
      cp_lr task.prereqs[0], File.dirname(task.name), remove_destination: true
    else
      cp task.prereqs[0], File.dirname(task.name)
    end
  end
end

# Compile SCSS
task :assets => 'build/style.css'
file 'build/style.css' => 'src/template/style.scss' do |task|
  verbose(false) { mkdir_p 'build' }
  dest, src = task.name, task.prereqs[0]
  puts "sass #{src} > #{dest}" if verbose
  result = Sass.compile(src, source_map: true, source_map_include_sources: true)
  File.write dest, result.css + "\n/*# sourceMappingURL=#{File.basename dest}.map */"
  File.write "#{dest}.map", result.source_map
end


# Misc HTML
%w(index 404).each do |name|
  task :build => "build/#{name}.html"
  file "build/#{name}.html" => "src/template/#{name}.erb" do |task|
    puts "Generate page #{task.name}" if verbose
    template = ERB.new File.read task.prereqs[0]
    html = template.result ERBContext.new(
      output_path: task.name,
      languages: LANGS,
    ).binding
    verbose(false) { mkdir_p File.dirname task.name }
    File.write task.name, html
  end
end


CLEAN << 'translated'
CLOBBER << 'build'
