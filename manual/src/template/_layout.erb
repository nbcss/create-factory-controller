<!DOCTYPE html>
<html lang="<%= language %>">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>
      <%= h title %> | <%= h t 'site-name' %>
      <% if display_branch and display_branch != 'main' %>
      · <%= display_branch %>
      <% end %>
    </title>
    <% if noindex or not document %>
    <meta name="robots" content="noindex, nofollow">
    <% end %>
    <% if not document %>
    <meta http-equiv="Cache-Control" content="no-store, no-cache, must-revalidate">
    <% end %>
    <% if canonical_url_base %>
    <link rel="canonical" href="<%= h File.join(canonical_url_base, url_path) %>">
    <% end %>
    <link rel="stylesheet" href="<%= h attach_cache_id '../style.css' %>">
  </head>

  <body>
    <header>
      <div class="header-inner">
        <div class="site-name"><%= h t 'site-name' %></div>
        <nav>
          <ol>
            <% if display_branch %>
            <li class="nav-item nav-version nav-version-fallback">
              <a title="<%= h t 'site-nav-change-version' %>" href="../../#manual">
                <% if display_branch == 'main' or display_branch =~ /^\d/ %>
                v<%= h mod_version %>
                <% else %>
                <%= display_branch %>
                <% end %>
              </a>
              <div class="nav-menu-container">
                <ul class="nav-menu"></ul>
              </div>
              <script>
              document.addEventListener('DOMContentLoaded', () => {
                fetch('../../', { mode: 'same-origin', headers: { "Cache-Control": "max-age=300" } })
                .then((res) => res.ok ? res.text() : Promise.reject())
                .then((resText) => {
                  // Parse site index for other manual versions
                  let resDoc = new DOMParser().parseFromString(resText, 'text/html');
                  let base = resDoc.createElement('base');
                  base.href = '../../';
                  resDoc.head.appendChild(base);
                  let versUrls = Array.from(resDoc.querySelectorAll('#manual ~ ul:first-of-type > li > a, #manual ~ ol:first-of-type > li > a'))
                  .map(a => a.href.replace(/\/$/, ''));
                  if (versUrls.length == 0) return;

                  // Add links to other versions of this page to a nav menu
                  const nv = document.querySelector('.nav-version');
                  nv.classList.remove('nav-version-fallback');
                  const navBtn = document.querySelector('.nav-version > a');
                  navBtn.href = "";
                  navBtn.addEventListener('click', (e) => e.preventDefault());
                  const navMenu = document.querySelector('.nav-version .nav-menu');
                  let links = versUrls.map((url) => {
                    let branch = url.match(/[^\/]*$/)[0].match(/(?:\:.+)?$/)[0].substr(1);
                    let li = document.createElement('li');
                    let a = document.createElement('a');
                    li.appendChild(a);
                    a.innerText = branch !== "" ? branch : <%= JSON.dump t 'site-nav-version-latest' %>;
                    a.href = url + '/';
                    navMenu.appendChild(li);
                    return [a, url + <%= JSON.dump url_path %>];
                  });
                  function checkLinks() {
                    ['focusin', 'mouseenter'].forEach(e => nv.removeEventListener(e, checkLinks));
                    links.forEach(([a, pageUrlInVer]) => {
                      fetch(pageUrlInVer, { method: 'HEAD' })
                      .then((res) => { if (res.ok) a.href = pageUrlInVer; });
                    });
                  }
                  ['focusin', 'mouseenter'].forEach(e => nv.addEventListener(e, checkLinks));
                })
              });
              </script>
            </li>
            <% end %>
            <% if manual_toc %>
            <li class="nav-item nav-project-toc">
              <button><%= h t 'site-nav-manual' %></button>
              <div class="nav-menu-container">
                <ol class="nav-menu">
                  <li><a href=".">
                    <span class="toc-menu-title"><%= h t 'site-nav-manual' %></span>
                    <span class="toc-menu-home"><%= h t 'site-nav-manual-home' %></span>
                  </a></li>
                  <%= manual_toc %>
                </ol>
              </div>
            </li>
            <% end %>
            <% if page_toc %>
            <li class="nav-item nav-page-toc">
              <button title="<%= h t 'toc-title' %>"><i class="fa-solid">&#xf03a;</i></button>
              <div class="nav-menu-container">
                <ol class="nav-menu">
                  <li><a href="#top">
                    <span class="toc-menu-title"><%= h title %></span>
                  </a></li>
                  <%= page_toc %>
                </ol>
              </div>
            </li>
            <% end %>
            <li class="nav-item nav-lang-select">
              <button title="<%= h t 'site-nav-langs' %>"><i class="fa-solid">&#xf1ab;</i>&ensp;<%= lang_name language %></button>
              <div class="nav-menu-container">
                <ul class="nav-menu">
                  <% languages.each do |lang| %>
                  <li><a rel="alternate" hreflang="<%= lang %>" href="../<%= lang %>/<%= h url_path.split('/', -1).last %>" lang="<%= lang %>">
                    <%= lang_name lang %>
                  </a></li>
                  <% end %>
                </ul>
              </div>
            </li>
          </ol>
        </nav>
      </div>
    </header>

    <main>
      <% if document %>
      <article>
        <h1><%= h title %></h1>
        <%= content %>
      </article>
      <% elsif content %>
      <%= content %>
      <% end %>
    </main>

    <footer>
      <div class="footer-inner">
        <% if authors && authors.any? %>
        <div><%= h t 'site-credit-authors-leadin' %> <%= h authors.join(', ') %></div>
        <% end %>
        <% if translators && translators.any? %>
        <div><%= h t 'site-credit-translators-leadin' %> <%= h translators.join(', ') %></div>
        <% end %>
        <div><a href="https://weblate.fiveyellowmice.com/engage/create-factory-controller/"><%= h t 'site-nav-help-translate' %></a></div>
      </div>
    </footer>
  </body>
</html>
