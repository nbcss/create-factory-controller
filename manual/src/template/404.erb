<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Page not found</title>
    <meta name="robots" content="noindex, nofollow">
    <meta http-equiv="Cache-Control" content="no-store, no-cache, must-revalidate">
  </head>
  <body>
    <h1>Page not found</h1>

    <script>
      // If this is a manual page with missing translation, redirect to translation-missing.html of the respective language
      const languages = [<%= languages[1..-1].map{|l| %("#{l}") }.join(',') %>];
      const defaultLanguage = "<%= languages.default %>";

      const path = window.location.pathname;

      const [matchedLanguage, pathIndex] = languages
      .map((language) => [language, path.indexOf(`/${language}/`)])
      .find(([, i]) => i != -1) || [];

      if (matchedLanguage) {
        const basePath = path.substring(0, pathIndex);
        const innerPath = path.substring(pathIndex + matchedLanguage.length + 2);

        Promise.all([
          `${basePath}/${defaultLanguage}/${innerPath}`,
          `${basePath}/${matchedLanguage}/translation-missing.html`,
        ].map((url) =>
          fetch(url, { method: 'HEAD' })
        )).then((responses) => {
          if (!responses.every((res) => res.ok)) return;

          const redirectingUrl = `${basePath}/${matchedLanguage}/translation-missing.html?page=${encodeURIComponent(innerPath+window.location.hash)}`
          window.location.replace(redirectingUrl);
        });
      }
    </script>
  </body>
</html>
